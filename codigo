                    { q: "¿Cuál de estas palabras rima con 'gato'?", a: ["Perro", "Pato", "Sol"], ok: "Pato" },
                    { q: "Escribe correctamente la palabra para nombrar un vehículo de cuatro ruedas: 🚗", type: "write", ok: "carro" },
                    { q: "¿Cómo se separan las sílabas de 'casa'? 🏠", a: ["ca - sa", "c - a - s - a", "cas - a"], ok: "ca - sa" },
                    { q: "Escribe la palabra completa que rime con 'Estrella' y sea una botella pequeña: 🧴", type: "write", ok: "botella" },
                    { q: "Escribe la palabra contraria de 'Día': 🌙", type: "write", ok: "noche" },
                    { q: "¿Cuál de estas palabras está escrita correctamente?", a: ["Zanahoria", "Sanahoria", "Canahoria"], ok: "Zanahoria" }
                ]
            },
            ethics: {
                easy: [
                    { q: "Si ves a un amiguito triste en la escuela, ¿qué debes hacer? 🤝", a: ["Ignorarlo", "Preguntarle si quiere jugar", "Burlarte"], ok: "Preguntarle si quiere jugar" },
                    { q: "Cuando queremos pedir un juguete, decimos... 💬", a: ["¡Dámelo ya!", "Por favor", "Llorar fuerte"], ok: "Por favor" },
                    { q: "¿Cuál de estos es un buen hábito?", a: ["Compartir los juguetes", "Gritar a mamá", "No lavarse las manos"], ok: "Compartir los juguetes" },
                    { q: "¿Qué hacemos si tiramos basura por accidente? 🗑️", a: ["La dejamos ahí", "La recogemos y ponemos en el bote", "La escondemos"], ok: "La recogemos y ponemos en el bote" },
                    { q: "¿Cómo saludamos al llegar a un lugar?", a: ["Sin decir nada", "Gritando", "Diciendo Buenos días o Hola"], ok: "Diciendo Buenos días o Hola" }
                ],
                medium: [
                    { q: "Si un amigo te comparte sus colores, ¿qué le dices?", a: ["Nada", "Gracias", "Quiero más"], ok: "Gracias" },
                    { q: "¿Qué debes hacer antes de comer? 🧼", a: ["Jugar en la tierra", "Lavarte las manos", "Dormir"], ok: "Lavarte las manos" },
                    { q: "¿Cómo ayudamos a mantener limpia la escuela?", a: ["Tirando papeles", "No haciendo nada", "Poniendo la basura en su lugar"], ok: "Poniendo la basura en su lugar" },
                    { q: "Si alguien está hablando en clase, nosotros... 🤫", a: ["Gritamos", "Escuchamos con atención", "Hacemos ruido"], ok: "Escuchamos con atención" },
                    { q: "Si ves que a un profesor se le caen unos papeles al suelo, ¿qué haces?", a: ["Pasar de largo", "Ayudarle a recogerlos", "Reírte"], ok: "Ayudarle a recogerlos" }
                ],
                hard: [
                    { q: "Si te prestan un juguete y se rompe sin querer, ¿qué haces?", a: ["Lo escondes", "Dices la verdad y pides disculpas", "Le echas la culpa a otro"], ok: "Dices la verdad y pides disculpas" },
                    { q: "¿Qué significa ser empático? 💖", a: ["Pensar y sentir cómo se siente el otro", "Ganar todos los juegos", "Enojarte rápido"], ok: "Pensar y sentir cómo se siente el otro" },
                    { q: "Ayudar en los deberes del hogar es...", a: ["Aburrido y malo", "Una excelente forma de cooperar en familia", "Solo tarea de los adultos"], ok: "Una excelente forma de cooperar en familia" },
                    { q: "Cuidar las plantas y a los animales es importante porque...", a: ["Son seres vivos y protegen nuestro planeta", "Dan dinero", "Podemos jugar rudo con ellos"], ok: "Son seres vivos y protegen nuestro planeta" },
                    { q: "Si un compañero de juego comete un error en el juego y pierden, ¿qué debes hacer?", a: ["Gritarle e insultarle", "Apoyarlo y decirle que lo harán mejor la próxima vez", "No volver a jugar con él"], ok: "Apoyarlo y decirle que lo harán mejor la próxima vez" }
                ]
            }
        };

        class AdventureApp {
            constructor() {
                this.stars = 0;
                this.difficulty = 'easy';
                this.currentSubject = null;
                this.questions = [];
                this.currentQuestionIdx = 0;
                this.selectedAnswer = null;

                // Robot grid states
                this.robotPos = { x: 0, y: 3 }; // Bottom-left corner (0-indexed)
                this.goalPos = { x: 3, y: 0 };  // Top-right corner
                this.walls = [{ x: 1, y: 1 }, { x: 2, y: 2 }, { x: 1, y: 2 }];
                this.commands = [];
                this.isPlayingRobot = false;
            }

            init() {
                this.updateHeader();
                this.goHome();
            }

            setDifficulty(diff) {
                this.difficulty = diff;
                document.getElementById('btn-diff-easy').className = diff === 'easy' ? 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all bg-white text-purple-700 shadow' : 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all text-white hover:bg-white/10';
                document.getElementById('btn-diff-medium').className = diff === 'medium' ? 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all bg-white text-purple-700 shadow' : 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all text-white hover:bg-white/10';
                document.getElementById('btn-diff-hard').className = diff === 'hard' ? 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all bg-white text-purple-700 shadow' : 'flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all text-white hover:bg-white/10';
                this.updateHeader();
            }

            updateHeader() {
                document.getElementById('header-stars').textContent = this.stars;
                
                let diffText = 'Fácil';
                if (this.difficulty === 'medium') diffText = 'Medio';
                else if (this.difficulty === 'hard') diffText = 'Difícil';
                
                document.getElementById('header-difficulty').textContent = diffText;
            }

            goHome() {
                document.getElementById('screen-home').classList.remove('hidden');
                document.getElementById('screen-game').classList.add('hidden');
                document.getElementById('screen-coding').classList.add('hidden');
                document.getElementById('stats-header').classList.add('hidden');
                this.currentSubject = null;
            }

            // Fisher-Yates shuffle helper
            shuffleArray(array) {
                for (let i = array.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [array[i], array[j]] = [array[j], array[i]];
                }
                return array;
            }

            startSubject(subject) {
                document.getElementById('stats-header').classList.remove('hidden');
                if (subject === 'coding') {
                    this.startCodingGame();
                } else {
                    this.currentSubject = subject;
                    // Clone questions array and shuffle it!
                    let originalQuestions = DATABASE[subject][this.difficulty];
                    this.questions = this.shuffleArray([...originalQuestions]);
                    this.currentQuestionIdx = 0;
                    this.showQuestion();
                }
            }

            showQuestion() {
                const qData = this.questions[this.currentQuestionIdx];
                this.selectedAnswer = null;
                
                // Reset feedback
                document.getElementById('game-feedback').classList.add('hidden');
                document.getElementById('btn-next-question').classList.add('hidden');
                
                // Setup badge
                const badgeText = {
                    math: "Matemáticas 📐",
                    english: "Inglés 🦁",
                    spanish: "Español 📚",
                    ethics: "Valores ❤️"
                }[this.currentSubject];
                
                document.getElementById('game-badge-emoji').textContent = badgeText.split(" ")[1] || "🌟";
                document.getElementById('game-badge-text').textContent = badgeText.split(" ")[0];
                document.getElementById('game-question-title').textContent = qData.q;
                
                // Listening / Web Speech Integration
                const audioContainer = document.getElementById('audio-assist-container');
                if (qData.type && qData.type.includes('listen')) {
                    audioContainer.classList.remove('hidden');
                    this.speakCurrentWord();
                } else {
                    audioContainer.classList.add('hidden');
                }

                // Input Selection layout modes:
                const optionsBox = document.getElementById('game-options-container');
                const writeBox = document.getElementById('game-write-container');
                const inputField = document.getElementById('game-text-input');
                
                inputField.value = ''; // Reset writing

                if (qData.type === 'write' || qData.type === 'listen_write') {
                    // Keyboard Write Mode
                    optionsBox.classList.add('hidden');
                    writeBox.classList.remove('hidden');
                    document.getElementById('game-question-subtitle').textContent = "Escribe la palabra con tu teclado físico y presiona enviar.";
                } else {
                    // Multiple Choice Mode
                    optionsBox.classList.remove('hidden');
                    writeBox.classList.add('hidden');
                    document.getElementById('game-question-subtitle').textContent = "Selecciona la respuesta correcta tocando una opción.";
                    
                    // Clear and inject options
                    optionsBox.innerHTML = '';
                    qData.a.forEach(option => {
                        const btn = document.createElement('button');
                        btn.className = "w-full border-2 border-slate-100 hover:border-violet-300 rounded-2xl p-4 text-left font-semibold text-slate-700 hover:bg-violet-50/50 transition-all flex items-center justify-between bouncy-btn group";
                        btn.innerHTML = `<span>${option}</span><span class='opacity-0 group-hover:opacity-100 transition-opacity text-violet-400'>👉</span>`;
                        btn.onclick = () => this.checkAnswer(option, btn);
                        optionsBox.appendChild(btn);
                    });
                }
                
                // Switch screen
                document.getElementById('screen-home').classList.add('hidden');
                document.getElementById('screen-game').classList.remove('hidden');
            }

            speakCurrentWord() {
                const qData = this.questions[this.currentQuestionIdx];
                if (qData && qData.speakWord && 'speechSynthesis' in window) {
                    const utterance = new SpeechSynthesisUtterance(qData.speakWord);
                    utterance.lang = 'en-US'; // Use native English for listening challenges
                    utterance.rate = 0.8;    // Slightly slower for children
                    window.speechSynthesis.speak(utterance);
                }
            }

            checkAnswer(selected, element) {
                if (this.selectedAnswer !== null) return; // Prevent multiple selection
                this.selectedAnswer = selected;
                const qData = this.questions[this.currentQuestionIdx];
                
                const feedbackBox = document.getElementById('game-feedback');
                feedbackBox.classList.remove('hidden');
                
                if (selected === qData.ok) {
                    element.classList.remove('border-slate-100', 'hover:border-violet-300');
                    element.classList.add('border-emerald-500', 'bg-emerald-50');
                    feedbackBox.className = "rounded-2xl p-4 text-center font-bold mb-4 flex items-center justify-center space-x-2 bg-emerald-100 text-emerald-800";
                    feedbackBox.innerHTML = "<span>🎉 ¡Excelente trabajo! ¡Es correcto! +1 Estrellita ⭐</span>";
                    this.stars += 1;
                    this.updateHeader();
                } else {
                    element.classList.remove('border-slate-100', 'hover:border-violet-300');
                    element.classList.add('border-rose-400', 'bg-rose-50');
                    feedbackBox.className = "rounded-2xl p-4 text-center font-bold mb-4 flex items-center justify-center space-x-2 bg-rose-100 text-rose-800";
                    feedbackBox.innerHTML = `<span>💡 ¡Casi! La respuesta era: ${qData.ok}</span>`;
                }
                
                document.getElementById('btn-next-question').classList.remove('hidden');
            }

            checkWrittenAnswer() {
                if (this.selectedAnswer !== null) return;
                
                const inputField = document.getElementById('game-text-input');
                const writtenValue = inputField.value.trim().toLowerCase();
                const qData = this.questions[this.currentQuestionIdx];
                
                if (!writtenValue) {
                    alert("¡Por favor escribe una palabra primero!");
                    return;
                }
                
                this.selectedAnswer = writtenValue;
                const feedbackBox = document.getElementById('game-feedback');
                feedbackBox.classList.remove('hidden');
                
                const expectedValue = qData.ok.trim().toLowerCase();
                
                if (writtenValue === expectedValue) {
                    feedbackBox.className = "rounded-2xl p-4 text-center font-bold mb-4 flex items-center justify-center space-x-2 bg-emerald-100 text-emerald-800";
                    feedbackBox.innerHTML = "<span>🎉 ¡Excelente ortografía! ¡Es correcto! +1 Estrellita ⭐</span>";
                    this.stars += 1;
                    this.updateHeader();
                } else {
                    feedbackBox.className = "rounded-2xl p-4 text-center font-bold mb-4 flex items-center justify-center space-x-2 bg-rose-100 text-rose-800";
                    feedbackBox.innerHTML = `<span>💡 ¡Casi! La palabra correcta es: <strong>${qData.ok}</strong></span>`;
                }
                
                document.getElementById('btn-next-question').classList.remove('hidden');
            }

            nextQuestion() {
                this.currentQuestionIdx++;
                if (this.currentQuestionIdx < this.questions.length) {
                    this.showQuestion();
                } else {
                    // Complete challenge
                    alert(`🌟 ¡Increíble! Has terminado esta aventura. Tienes un total de ${this.stars} estrellas.`);
                    this.goHome();
                }
            }

            /* ROBOTICS LOGIC */
            startCodingGame() {
                document.getElementById('screen-home').classList.add('hidden');
                document.getElementById('screen-coding').classList.remove('hidden');
                this.robotPos = { x: 0, y: 3 }; 
                this.commands = [];
                this.renderGrid();
                this.renderQueue();
                const feed = document.getElementById('coding-feedback');
                feed.classList.add('hidden');
            }

            renderGrid() {
                const grid = document.getElementById('robot-grid');
                grid.innerHTML = '';
                for (let y = 0; y < 4; y++) {
                    for (let x = 0; x < 4; x++) {
                        const cell = document.createElement('div');
                        cell.className = "bg-white rounded-xl flex items-center justify-center text-xl font-bold shadow-sm relative border border-slate-200/50";
                        
                        // Is wall?
                        const isWall = this.walls.some(w => w.x === x && w.y === y);
                        if (isWall) {
                            cell.className += " bg-slate-400 text-white";
                            cell.textContent = "🧱";
                        } 
                        // Is Goal?
                        else if (this.goalPos.x === x && this.goalPos.y === y) {
                            cell.className += " bg-amber-50 border-2 border-dashed border-amber-300";
                            cell.textContent = "🏁";
                        }
                        // Is Robot?
                        if (this.robotPos.x === x && this.robotPos.y === y) {
                            cell.textContent = "🤖";
                            cell.className += " scale-110 floating";
                        }
                        
                        grid.appendChild(cell);
                    }
                }
            }

            addCommand(direction) {
                if (this.commands.length >= 8) {
                    alert("¡Tu memoria de comandos está llena! Ejecuta o borra para agregar más.");
                    return;
                }
                this.commands.push(direction);
                this.renderQueue();
            }

            clearCommands() {
                this.commands = [];
                this.renderQueue();
                this.robotPos = { x: 0, y: 3 };
                this.renderGrid();
                const feed = document.getElementById('coding-feedback');
                feed.classList.add('hidden');
            }

            renderQueue() {
                const queueBox = document.getElementById('command-queue');
                if (this.commands.length === 0) {
                    queueBox.innerHTML = `<span class="text-slate-400 text-xs italic">Agrega comandos arriba...</span>`;
                    return;
                }
                queueBox.innerHTML = '';
                this.commands.forEach((cmd, idx) => {
                    const badge = document.createElement('span');
                    const emoji = { UP: '⬆️', DOWN: '⬇️', LEFT: '⬅️', RIGHT: '➡️' }[cmd];
                    badge.className = "bg-violet-100 text-violet-700 text-xs px-2.5 py-1 rounded-lg border border-violet-200 font-bold flex items-center space-x-1";
                    badge.innerHTML = `<span>${emoji}</span>`;
                    queueBox.appendChild(badge);
                });
            }

            async runRobot() {
                if (this.commands.length === 0) {
                    alert("Por favor, agrega comandos primero.");
                    return;
                }
                
                const feed = document.getElementById('coding-feedback');
                feed.className = "rounded-xl p-3 text-center text-xs font-bold bg-amber-100 text-amber-800";
                feed.textContent = "🤖 Ejecutando secuencia...";
                feed.classList.remove('hidden');
                
                // Reset position to begin execution
                this.robotPos = { x: 0, y: 3 };
                this.renderGrid();

                for (let i = 0; i < this.commands.length; i++) {
                    await new Promise(resolve => setTimeout(resolve, 800));
                    const cmd = this.commands[i];
                    let nextPos = { ...this.robotPos };
                    
                    if (cmd === 'UP') nextPos.y--;
                    else if (cmd === 'DOWN') nextPos.y++;
                    else if (cmd === 'LEFT') nextPos.x--;
                    else if (cmd === 'RIGHT') nextPos.x++;
                    
                    // Out of bounds check
                    if (nextPos.x < 0 || nextPos.x > 3 || nextPos.y < 0 || nextPos.y > 3) {
                        feed.className = "rounded-xl p-3 text-center text-xs font-bold bg-rose-100 text-rose-800";
                        feed.textContent = "💥 ¡Oh no! El robot intentó salir del laberinto.";
                        return;
                    }
                    
                    // Collision check
                    const hitsWall = this.walls.some(w => w.x === nextPos.x && w.y === nextPos.y);
                    if (hitsWall) {
                        feed.className = "rounded-xl p-3 text-center text-xs font-bold bg-rose-100 text-rose-800";
                        feed.textContent = "💥 ¡Choque! Chocaste contra una pared 🧱";
                        return;
                    }
                    
                    this.robotPos = nextPos;
                    this.renderGrid();
                }
                
                // Final check
                if (this.robotPos.x === this.goalPos.x && this.robotPos.y === this.goalPos.y) {
                    feed.className = "rounded-xl p-3 text-center text-xs font-bold bg-emerald-100 text-emerald-800";
                    feed.textContent = "🎉 ¡Felicidades! Lograste programar al robot hasta la meta. +3 Estrellas ⭐";
                    this.stars += 3;
                    this.updateHeader();
                } else {
                    feed.className = "rounded-xl p-3 text-center text-xs font-bold bg-slate-100 text-slate-700";
                    feed.textContent = "🏁 El robot se detuvo antes de llegar a la meta. ¡Intenta otra secuencia!";
                }
            }
        }

        // Instance and initialize
        const app = new AdventureApp();
        document.addEventListener('DOMContentLoaded', () => {
            app.init();
        });
        // Safe initial call just in case DOM loaded already
        setTimeout(() => {
            app.init();
        }, 100);
    </script>
