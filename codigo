%%html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aventuras Infantiles Educativas</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Fredoka -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            min-height: 100vh;
        }
        .bouncy-btn {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .bouncy-btn:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12);
        }
        .bouncy-btn:active {
            transform: translateY(1px) scale(0.98);
        }
        .card-shadow {
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .floating {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="text-slate-700 flex flex-col min-h-screen">

    <!-- Top Navigation Bar -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-rose-100 shadow-sm px-4 py-3">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="app.goHome()">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-400 to-rose-400 flex items-center justify-center text-white text-2xl shadow-md">
                    🌟
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-gradient-to-r from-violet-600 to-rose-500 bg-clip-text text-transparent">Aventuras Mágicas</h1>
                    <p class="text-xs text-slate-400 font-medium">Aprende jugando (5+ años)</p>
                </div>
            </div>

            <div id="stats-header" class="hidden flex items-center space-x-4 bg-slate-50 border border-slate-200/60 px-4 py-1.5 rounded-full shadow-inner">
                <div class="flex items-center space-x-1">
                    <span class="text-amber-500 text-lg">⭐</span>
                    <span id="header-stars" class="font-bold text-slate-700">0</span>
                </div>
                <div class="h-4 w-px bg-slate-200"></div>
                <div class="text-xs font-semibold uppercase tracking-wider text-violet-600" id="header-difficulty">Fácil</div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-6 flex flex-col justify-center items-center">

        <!-- 1. HOME SCREEN / SUBJECT SELECTION -->
        <div id="screen-home" class="w-full space-y-6">
            <!-- Welcome Banner -->
            <div class="bg-gradient-to-r from-violet-500 via-purple-500 to-pink-500 rounded-3xl p-6 sm:p-10 text-white card-shadow relative overflow-hidden flex flex-col md:flex-row items-center justify-between">
                <div class="absolute -right-10 -bottom-10 text-9xl opacity-20 select-none pointer-events-none">🚀</div>
                <div class="z-10 text-center md:text-left mb-6 md:mb-0">
                    <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">¡Bienvenido amiguito!</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold mb-2">¿Qué aventura jugaremos hoy?</h2>
                    <p class="text-white/90 text-sm sm:text-base max-w-md">Elige una materia, selecciona qué tan retador lo quieres y acumula estrellas doradas.</p>
                </div>

                <!-- Difficulty Selector Box -->
                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 text-center z-10 w-full md:w-auto min-w-[240px]">
                    <p class="text-xs uppercase font-bold tracking-wider mb-2 text-white/80">Dificultad de Retos</p>
                    <div class="inline-flex rounded-lg bg-black/10 p-1 w-full">
                        <button onclick="app.setDifficulty('easy')" id="btn-diff-easy" class="flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all bg-white text-purple-700 shadow">Fácil</button>
                        <button onclick="app.setDifficulty('medium')" id="btn-diff-medium" class="flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all text-white hover:bg-white/10">Medio</button>
                        <button onclick="app.setDifficulty('hard')" id="btn-diff-hard" class="flex-1 py-1 px-2.5 text-xs font-bold rounded-md transition-all text-white hover:bg-white/10">Difícil</button>
                    </div>
                </div>
            </div>

            <!-- Subject Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Math -->
                <div onclick="app.startSubject('math')" class="bouncy-btn bg-white rounded-3xl p-6 border-2 border-amber-200 cursor-pointer card-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-amber-100 text-3xl flex items-center justify-center mb-4 floating">📐</div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Matemáticas</h3>
                    <p class="text-slate-400 text-xs">Sumas, restas y figuras divertidas</p>
                </div>
                <!-- English -->
                <div onclick="app.startSubject('english')" class="bouncy-btn bg-white rounded-3xl p-6 border-2 border-violet-200 cursor-pointer card-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-violet-100 text-3xl flex items-center justify-center mb-4 floating" style="animation-delay: 0.5s;">🦁</div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Inglés</h3>
                    <p class="text-slate-400 text-xs">Aprende palabras, escucha y escribe</p>
                </div>
                <!-- Spanish -->
                <div onclick="app.startSubject('spanish')" class="bouncy-btn bg-white rounded-3xl p-6 border-2 border-emerald-200 cursor-pointer card-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-3xl flex items-center justify-center mb-4 floating" style="animation-delay: 1s;">📚</div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Español</h3>
                    <p class="text-slate-400 text-xs">Letras, ortografía y retos de escritura</p>
                </div>
                <!-- Ethics -->
                <div onclick="app.startSubject('ethics')" class="bouncy-btn bg-white rounded-3xl p-6 border-2 border-rose-200 cursor-pointer card-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-rose-100 text-3xl flex items-center justify-center mb-4 floating" style="animation-delay: 1.5s;">❤️</div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Valores y Ética</h3>
                    <p class="text-slate-400 text-xs">Decisiones buenas y amabilidad</p>
                </div>
                <!-- Coding/Robotics Grid -->
                <div onclick="app.startSubject('coding')" class="bouncy-btn bg-white rounded-3xl p-6 border-2 border-sky-200 cursor-pointer card-shadow flex flex-col items-center text-center sm:col-span-2 lg:col-span-1">
                    <div class="w-16 h-16 rounded-2xl bg-sky-100 text-3xl flex items-center justify-center mb-4 floating" style="animation-delay: 2s;">🤖</div>
                    <h3 class="text-xl font-bold text-slate-800 mb-1">Robótica y Lógica</h3>
                    <p class="text-slate-400 text-xs">¡Ayuda al robot a llegar a la meta!</p>
                </div>
            </div>
        </div>

        <!-- 2. GAME SCREEN (GENERAL QUESTIONS / AUDIO / KEYBOARD) -->
        <div id="screen-game" class="hidden w-full max-w-xl bg-white rounded-3xl border border-slate-100 card-shadow p-6 sm:p-8 flex flex-col relative">
            <button onclick="app.goHome()" class="absolute top-4 right-4 text-slate-300 hover:text-slate-500 text-xl font-bold transition-all">&times; Salir</button>
            
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-2 text-violet-500 text-xs uppercase font-bold tracking-wider">
                    <span id="game-badge-emoji">📐</span>
                    <span id="game-badge-text">Matemáticas</span>
                </div>
                <!-- Speak / Audio Assist Indicator -->
                <div id="audio-assist-container" class="hidden">
                    <button id="btn-speak" onclick="app.speakCurrentWord()" class="bouncy-btn bg-violet-100 hover:bg-violet-200 text-violet-700 font-bold px-3 py-1.5 rounded-full text-xs flex items-center space-x-1">
                        <span>🔊 Escuchar de nuevo</span>
                    </button>
                </div>
            </div>

            <!-- Question Text -->
            <div class="mb-6">
                <h2 id="game-question-title" class="text-2xl font-bold text-slate-800 mb-2">¿Cuánto es 2 + 2?</h2>
                <p id="game-question-subtitle" class="text-slate-400 text-sm">Selecciona la respuesta correcta tocando una opción.</p>
            </div>

            <!-- Interactive Input Modes -->
            <div>
                <!-- Mode A: Option Buttons -->
                <div id="game-options-container" class="grid grid-cols-1 gap-4 mb-6">
                    <!-- Options injected dynamically -->
                </div>

                <!-- Mode B: Keyboard Writing Container -->
                <div id="game-write-container" class="hidden mb-6 space-y-4">
                    <input type="text" id="game-text-input" autocomplete="off" placeholder="Escribe tu respuesta aquí..." 
                           class="w-full text-center text-xl font-bold px-4 py-3 rounded-2xl border-2 border-slate-200 focus:border-violet-500 outline-none transition-all">
                    <button id="btn-submit-text" onclick="app.checkWrittenAnswer()" class="w-full bg-violet-600 hover:bg-violet-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg transition-all text-sm bouncy-btn">
                        Enviar respuesta 🚀
                    </button>
                </div>
            </div>

            <!-- Feedback Box -->
            <div id="game-feedback" class="hidden rounded-2xl p-4 text-center font-bold mb-4 flex items-center justify-center space-x-2"></div>

            <!-- Bottom Navigation -->
            <div class="flex justify-end">
                <button id="btn-next-question" onclick="app.nextQuestion()" class="bg-violet-600 hover:bg-violet-700 text-white font-bold py-3 px-6 rounded-2xl shadow-lg transition-all text-sm bouncy-btn flex items-center space-x-2">
                    <span>Siguiente</span>
                    <span>➔</span>
                </button>
            </div>
        </div>

        <!-- 3. SPECIAL GAME SCREEN (ROBOTICS GRID) -->
        <div id="screen-coding" class="hidden w-full max-w-4xl grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Grid and Game Board (8 cols) -->
            <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-100 card-shadow p-6 flex flex-col items-center justify-center relative">
                <button onclick="app.goHome()" class="absolute top-4 right-4 text-slate-300 hover:text-slate-500 text-xl font-bold transition-all">&times; Salir</button>
                <h2 class="text-xl font-bold text-slate-800 self-start mb-2">🤖 Programemos al Robot</h2>
                <p class="text-slate-400 text-xs self-start mb-4">Crea una secuencia de pasos para que el Robot llegue hasta la meta. ¡Cuidado con los muros!</p>
                
                <!-- The Grid View -->
                <div id="robot-grid" class="grid grid-cols-4 gap-2 w-full max-w-[320px] aspect-square bg-slate-100 p-2.5 rounded-2xl border-4 border-slate-200">
                    <!-- Cells will be dynamic -->
                </div>
            </div>

            <!-- Instruction Builder and Controls (5 cols) -->
            <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-100 card-shadow p-6 flex flex-col justify-between">
                <div>
                    <h3 class="text-base font-bold text-slate-800 mb-3">🛠️ Panel de Instrucciones</h3>
                    
                    <!-- Buttons to Add Commands -->
                    <div class="grid grid-cols-3 gap-2 mb-6">
                        <button onclick="app.addCommand('UP')" class="bouncy-btn bg-sky-50 hover:bg-sky-100 border border-sky-100 rounded-xl py-3 flex flex-col items-center text-xs font-bold text-sky-600">
                            <span class="text-lg">⬆️</span>
                            <span>Subir</span>
                        </button>
                        <button onclick="app.addCommand('DOWN')" class="bouncy-btn bg-sky-50 hover:bg-sky-100 border border-sky-100 rounded-xl py-3 flex flex-col items-center text-xs font-bold text-sky-600">
                            <span class="text-lg">⬇️</span>
                            <span>Bajar</span>
                        </button>
                        <button onclick="app.addCommand('LEFT')" class="bouncy-btn bg-sky-50 hover:bg-sky-100 border border-sky-100 rounded-xl py-3 flex flex-col items-center text-xs font-bold text-sky-600">
                            <span class="text-lg">⬅️</span>
                            <span>Izquierda</span>
                        </button>
                        <button onclick="app.addCommand('RIGHT')" class="bouncy-btn bg-sky-50 hover:bg-sky-100 border border-sky-100 rounded-xl py-3 flex flex-col items-center text-xs font-bold text-sky-600 col-span-3 mt-1">
                            <span class="text-lg">➡️</span>
                            <span>Derecha</span>
                        </button>
                    </div>

                    <!-- Visualizing Current Queue -->
                    <div class="mb-4">
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-2">Secuencia de comandos:</p>
                        <div id="command-queue" class="flex flex-wrap gap-2 p-3 bg-slate-50 rounded-xl border border-dashed border-slate-200 min-h-[50px] items-center">
                            <span class="text-slate-400 text-xs italic">Agrega comandos arriba...</span>
                        </div>
                    </div>
                </div>

                <!-- Play and Reset Buttons -->
                <div class="space-y-3">
                    <div id="coding-feedback" class="hidden rounded-xl p-3 text-center text-xs font-bold"></div>
                    <div class="flex space-x-2">
                        <button onclick="app.clearCommands()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-3 rounded-xl text-xs transition-all">
                            🗑️ Limpiar
                        </button>
                        <button onclick="app.runRobot()" class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl text-xs transition-all flex items-center justify-center space-x-1 shadow-lg shadow-emerald-500/20">
                            <span>▶️ Ejecutar</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Success Modals and Audio/Visual Confetti -->
    <footer class="py-4 text-center text-xs text-slate-400/80">
        Desarrollado con ❤️ para niños geniales • Aventuras Mágicas
    </footer>

